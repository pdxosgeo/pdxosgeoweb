---
import site from '../data/site.json';

const pathname = Astro.url.pathname;
const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Meetings', href: '/meetings/' },
  { label: 'Map of the Month', href: '/map-of-the-month/' },
  { label: 'Join', href: '/#join' },
  { label: 'About', href: '/#about' },
];

const isActive = (href: string) =>
  href === '/' ? pathname === '/' : !href.includes('#') && pathname.startsWith(href);
---

<header class="hero">
  <a class="hero__brand" href="/">
    <img src="/images/logo.png" alt="PDXOSGeo logo" width="100" height="101" />
    <span class="hero__title">{site.title}</span>
  </a>
  <p class="hero__tagline">{site.tagline}</p>
</header>

<nav class="navbar" aria-label="Main">
  <ul>
    {
      navItems.map((item) => (
        <li>
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
